    },
    "compositorTime": "unavailable-unless-independently-observed",
    "visibleOutput": "Headed screenshots of the settled-first replay at each scene, outside the timed workload.",
    "lateIssuanceThresholdMs": 4,
    "roundPositiveWaitsUpToWholeMs": true,
    "absoluteTargets": true,
    "record": [
      "rearm-count",
      "late-issuance",
      "long-task-entries"
    ],
    "singleAverageFpsIsAcceptanceEvidence": false
  },
  "classification": {
    "precedence": [
      "established-application-target-failure",
      "demonstrated-harness-failure",
      "unexplained-timing-anomaly",
      "valid-passing-trial"
    ],
    "applicationFailure": "failed regardless of timing anomalies; any established application target failure prevents scene acceptance",
    "harnessFailure": "excluded only with demonstrated harness failure and no established application target failure",
    "unexplainedAnomaly": "inconclusive and non-accepting",
    "insufficientPassingTrials": "inconclusive and non-accepting",
    "coverage": "failed or missing coverage cannot satisfy a target"
