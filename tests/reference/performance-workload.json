    "suitePerScene": true,
    "suiteTimeoutMs": 600000,
    "requiredPassing": 3,
    "maxAttempts": 5,
    "recordEveryAttempt": true,
    "silentRetry": false
  },
  "targets": {
    "completedDraftsPerSecondMin": 30,
    "consecutiveDraftIntervalP95Ms": 50,
    "interactionP95Ms": 100,
    "stressReplacementMs": 250,
    "applicationMainThreadTaskMaxMs": 50,
    "firstSettledImageMs": 2000
