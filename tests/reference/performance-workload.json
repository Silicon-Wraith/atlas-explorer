  "workloads": {
    "phaseOrder": [
      "orbit",
      "settled-after-orbit",
      "interaction",
      "stress",
      "coverage-replay"
    ],
    "phaseBoundary": "Do not start interaction until the post-orbit full-quality render completes. Drain all submissions between phases under existing operation/suite bounds. Phase-local issuance uses absolute targets; waiting never restarts a request latency clock.",
    "orbit": {
      "durationMs": 30000,
      "radiansPerSecond": 0.5,
      "axis": "world-Z",
      "focusLocal": [
        0,
        0,
        0
      ],
      "upright": true,
      "startPose": "overview",
      "requestRule": {
        "firstIndex": 0,
        "lastIndex": 1874,
        "spacingMs": 16
      },
      "yawRule": "0.5 * (16 * k) / 1000 radians from overview",
      "cameraPoses": null
    },
    "interaction": {
      "cameraRequests": 400,
      "requestRule": {
        "firstIndex": 1,
        "lastIndex": 400,
        "spacingMs": 60
      },
      "startPose": "last-issued-orbit-pose",
      "startYawRadians": 14.992,
      "yawRule": "14.992 + 0.5 * (60 * j) / 1000 radians from overview",
      "cameraPoses": null
    },
    "stress": {
      "durationMs": 10000,
      "cameraPose": "last-issued-interaction-pose",
      "editRule": {
        "count": 40,
        "firstTimeMs": 0,
        "spacingMs": 250,
        "firstValue": "alternate"
      },
      "alternations": {
        "bulb": {
          "path": "parameters.power",
          "base": "8",
          "alternate": "7"
        },
        "quaternion": {
          "path": "parameters.kappa",
          "base": "0",
          "alternate": "0.5"
        },
        "menger": {
          "path": "parameters.depth",
          "base": 2,
          "alternate": 1
        }
      },
      "valueRule": "even edit indices use alternate; odd indices use base; final edit restores base"
    },
    "settled": {
      "trigger": "automatic settle after the final issued orbit pose",
      "start": "creation of that settled request, observed in the page",
      "stop": "first complete full-resolution geometry, normals and direct-light publication",
      "fullQuality": "record separately and finish before interaction"
    }
  },
  "seeds": {
    "sampling": 1,
    "harnessRandomness": false
  },
  "warmup": {
    "firstTrial": "cold-after-fresh-page-load",
    "subsequentTrials": "same-page-without-reload",
    "procedure": "Prepare, then run and record the complete workload. No discarded warm-up trial. Before each later attempt restore the frozen base scene and overview pose and drain outstanding work outside the timed phases; never reload the page."
